# Maintainer: Marco <mint@muu.space>
pkgname=cha
pkgver=0.1.0
pkgrel=1
pkgdesc='A forge CLI for Gitea, Forgejo and GitHub'
arch=('x86_64' 'aarch64')
url='https://github.com/mintktkr/cha'
license=('MIT')
depends=('glibc' 'openssl')
makedepends=('git' 'clang')
install=cha.install
_bendver=2.0.39
source=("git+https://github.com/mintktkr/cha.git#tag=v$pkgver")
source_x86_64=("https://github.com/bendlang/bend/releases/download/v$_bendver/bend-$_bendver-linux-x64.tar.gz")
source_aarch64=("https://github.com/bendlang/bend/releases/download/v$_bendver/bend-$_bendver-linux-arm64.tar.gz")
sha256sums=('SKIP')
sha256sums_x86_64=('6cf462fd8f70b094a4950ebb709a9c4ffd8f1d1189d9cedf1fd63cd5d041c7ab')
sha256sums_aarch64=('71b43e1bb9313dd14ac2b0553b854e41c39d65ecaa47040796ebff4a46f54a97')

build() {
  cd cha
  # bend fetches the hub packages main.bend imports, checked against their hashes
  "$srcdir/bend/bin/bend" main.bend -o cha
}

check() {
  cd cha
  [ "$(./cha version)" = "$pkgver" ]
  [ "$(./cha help | grep -c $'\x1b')" = 0 ]
}

package() {
  cd cha
  install -Dm755 cha "$pkgdir/usr/bin/cha"
  ./cha completions fish | install -Dm644 /dev/stdin "$pkgdir/usr/share/fish/vendor_completions.d/cha.fish"
  install -Dm644 skills/cha/SKILL.md "$pkgdir/usr/share/cha/skills/cha/SKILL.md"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
