  match m:
    case Some{X509.Cert{+der, +tbs, +sig_alg, +sig, +issuer, +subject, +not_before, +not_after, +key_alg, +key_curve, +key, +dns, +ca, +path_len, +key_usage, +unknown_critical, +server_auth}}:
