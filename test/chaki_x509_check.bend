       T.eq("int: sig_alg", sig_alg, "1.2.840.113549.1.1.11"),
       T.hex("int: issuer", issuer, "304d310b300906035504061302434c3113301106035504080c0a4d6167616c6c616e65733111300f060355040a0c0863686120746573743116301406035504030c0d636861207465737420726f6f74"),
       T.hex("int: subject", subject, "3055310b300906035504061302434c3113301106035504080c0a4d6167616c6c616e65733111300f060355040a0c086368612074657374311e301c06035504030c15636861207465737420696e7465726d656469617465"),
       T.hex("int: sig", sig, ""),
       T.eq("int: not_before", U32.show(not_before), "1791084346"),
       T.eq("int: not_after", U32.show(not_after), "1948764346"),
       T.eq("int: key_alg", key_alg, "1.2.840.10045.2.1"),
       T.eq("int: key_curve", key_curve, "1.2.840.10045.3.1.7"),
       T.hex("int: key", key, "04118f24163341627524fc742a908cc608dce259acb7d489d6f9a45f74019059ab7f07dd4c721a23a61d40a48b52ba51f63f5a47e1823ddad3b65bee28f4931c95"),
       T.eq("int: dns", dns.text(dns), ""),
