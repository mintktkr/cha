       T.eq("int: unknown_critical", T.yes(unknown_critical), "no"),
       T.eq("int: server_auth", T.yes(server_auth), "yes")]
    case None{}:
      [T.eq("int: parsed", "F", "Some")]

def leaf.checks(m: Maybe<&2, X509.Cert>) -> List<&2, String>:
