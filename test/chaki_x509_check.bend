# offline checks for lib/chaki/x509.bend
# The fixtures are synthetic, generated on this machine with openssl:
#
#   openssl req -x509 -newkey rsa:2048 -nodes -keyout root.key -out root.pem -days 3650 \
#     -subj "/C=CL/ST=Magallanes/O=cha test/CN=cha test root" \
#     -addext "basicConstraints=critical,CA:TRUE" \
#     -addext "keyUsage=critical,keyCertSign,cRLSign" -addext "subjectKeyIdentifier=hash"
#   # an EC P-256 intermediate, CA:TRUE, pathlen:0, signed by the root
#   openssl req -new -newkey ec -pkeyopt ec_paramgen_curve:P-256 -nodes -keyout int.key \
#     -out int.csr -subj "/C=CL/ST=Magallanes/O=cha test/CN=cha test intermediate"
#   openssl x509 -req -in int.csr -CA root.pem -CAkey root.key -CAcreateserial -out int.pem \
#     -days 1825 -extfile int.ext   # basicConstraints=critical,CA:TRUE,pathlen:0
#   # an EC P-384 leaf signed by the intermediate, SAN DNS:cha.test, DNS:*.Cha.TEST
#   openssl req -new -newkey ec -pkeyopt ec_paramgen_curve:P-384 -nodes -keyout leaf.key \
#     -out leaf.csr -subj "/C=CL/ST=Magallanes/O=cha test/CN=cha.test"
#   openssl x509 -req -in leaf.csr -CA int.pem -CAkey int.key -CAcreateserial -out leaf.pem \
#     -days 365 -extfile leaf.ext  # basicConstraints=critical,CA:FALSE, keyUsage=critical,digitalSignature,
#                                  # extendedKeyUsage=serverAuth, subjectAltName=DNS:cha.test,DNS:*.Cha.TEST
#   # a v1 certificate: the root's ca-signed CSR re-signed over a TBSCertificate with the
#   # version element and the extensions removed (v1 carries neither)
#   # a CA with a critical nameConstraints extension, which this engine must mark unknown
#   openssl x509 -req -in nc.csr -CA root.pem -CAkey root.key -CAcreateserial -out nc.pem \
#     -days 365 -extfile nc.ext   # basicConstraints=critical,CA:TRUE, keyUsage=critical,keyCertSign,
#                                 # nameConstraints=critical,permitted;DNS:.example.com
#   # two self-signed EC P-256 leaves, one for anyExtendedKeyUsage and one for clientAuth only
#   openssl req -x509 -newkey ec -pkeyopt ec_paramgen_curve:P-256 -nodes \
#     -not_before 20261001000000Z -not_after 20271001000000Z \
#     -subj "/C=CL/ST=Magallanes/O=cha test/CN=any.cha.test" -keyout any.key -out any.pem \
#     -addext "basicConstraints=critical,CA:FALSE" -addext "keyUsage=critical,digitalSignature" \
#     -addext "extendedKeyUsage=anyExtendedKeyUsage" -addext "subjectAltName=DNS:any.cha.test"
#   # the same with CN=eku.cha.test, DNS:eku.cha.test and extendedKeyUsage=clientAuth
#   # and then a copy of that DER with the tag of the extKeyUsage OID changed from 06 to 02,
#   # so the extension no longer holds a SEQUENCE OF OBJECT IDENTIFIER
#
# and then `openssl x509 -outform DER | xxd -p -c 1000` for each. The times, the two names,
# the key and the signature bytes below come from `openssl x509 -text` and `openssl asn1parse`.
import Base
import ../lib/chaki/bytes.bend as Bytes
import ../lib/chaki/asn1.bend as Asn1
import ../lib/chaki/x509.bend as X509
import ../lib/chaki/check.bend as T

