def eku.any.checks(m: Maybe<&2, X509.Cert>) -> List<&2, String>:
  match m:
    case Some{X509.Cert{d, t, sa, s, i, su, nb, na, ka, kc, k, +dns, ca, pl, ku, uc, +server_auth}}:
      [T.eq("eku any: server_auth", T.yes(server_auth), "yes"),
       T.eq("eku any: dns", dns.text(dns), "any.cha.test")]
    case None{}:
      [T.eq("eku any: parsed", "F", "Some")]

def eku.client.checks(m: Maybe<&2, X509.Cert>) -> List<&2, String>:
  match m:
    case Some{X509.Cert{d, t, sa, s, i, su, nb, na, ka, kc, k, +dns, ca, pl, ku, uc, +server_auth}}:
      [T.eq("eku client: server_auth", T.yes(server_auth), "no"),
       T.eq("eku client: dns", dns.text(dns), "eku.cha.test")]
    case None{}:
      [T.eq("eku client: parsed", "F", "Some")]

def main() -> IO(Unit):
  do IO<Unit>:
    a : Unit <- print.lines(root.checks(X509.parse(root.der())))
    b : Unit <- print.lines(int.checks(X509.parse(int.der())))
    c : Unit <- print.lines(leaf.checks(X509.parse(leaf.der())))
    d : Unit <- print.lines(v1.checks(X509.parse(v1.der())))
    e : Unit <- print.lines(nc.checks(X509.parse(nc.der())))
    f : Unit <- print.lines(eku.any.checks(X509.parse(eku_any.der())))
    g : Unit <- print.lines(eku.client.checks(X509.parse(eku_client.der())))
    IO.print(T.eq("truncated certificate refused", ok.of(X509.parse(Bytes.take(root.der(), 100n))), "F"))
    IO.print(T.eq("trailing byte refused", ok.of(X509.parse(Bytes.cat(root.der(), [0]))), "F"))
    IO.print(T.eq("empty input refused", ok.of(X509.parse(Nil{})), "F"))
    IO.print(T.eq("an element that isn't a certificate refused", ok.of(X509.parse(Bytes.of_hex("04 03 01 02 03"))), "F"))
    IO.print(T.eq("an OCTET STRING where a SEQUENCE belongs refused", ok.of(X509.parse(Bytes.of_hex("02 01 05"))), "F"))
    IO.print(T.eq("a signature with an unused bit refused", ok.of(X509.parse(root_unused.der())), "F"))
    IO.print(T.eq("a malformed extKeyUsage refused", ok.of(X509.parse(eku_bad.der())), "F"))
    return e
