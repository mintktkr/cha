       T.hex("leaf: issuer", issuer, "3055310b300906035504061302434c3113301106035504080c0a4d6167616c6c616e65733111300f060355040a0c086368612074657374311e301c06035504030c15636861207465737420696e7465726d656469617465"),
       T.hex("leaf: subject", subject, "3048310b300906035504061302434c3113301106035504080c0a4d6167616c6c616e65733111300f060355040a0c0863686120746573743111300f06035504030c086368612e74657374"),
       T.hex("leaf: sig", sig, "30440220337cb262a559c1ff8bd578739f3415f9d2008400010f272b62ac5c5000ee742b02201326bf74c817621528e87fc35c4695feec47988105ad523dfe7a9054a23892fd"),
       T.eq("leaf: not_before", U32.show(not_before), "1791084346"),
       T.eq("leaf: not_after", U32.show(not_after), "1822620346"),
       T.eq("leaf: key_alg", key_alg, "1.2.840.10045.2.1"),
       T.eq("leaf: key_curve", key_curve, "1.3.132.0.34"),
       T.hex("leaf: key", key, "04fc41bdda4b204500744c5b3360520f5943f6b0e1f7b7ec0184877a1c06c62e9513bcbee4d45ffe750d2859e88e79c569ce05c2cb1f8c2dbeb4ef66f3046edd10e89bc29fdf7f2740da8f9fb5222b222d17a6c721f9d120505c502d9c5a4015a2"),
       T.eq("leaf: dns", dns.text(dns), "cha.test,*.cha.test"),
       T.eq("leaf: ca", T.yes(ca), "no"),
       T.eq("leaf: path_len", U32.show(path_len), "4294967295"),
       T.eq("leaf: key_usage", U32.show(key_usage), "1"),
       T.eq("leaf: unknown_critical", T.yes(unknown_critical), "no"),
       T.eq("leaf: server_auth", T.yes(server_auth), "yes"),
       T.eq("leaf: ecdsa_sig", key.text(X509.ecdsa_sig(sig)), "337cb262a559c1ff8bd578739f3415f9d2008400010f272b62ac5c5000ee742b:1326bf74c817621528e87fc35c4695feec47988105ad523dfe7a9054a23892fd"),
       T.eq("leaf: rsa_key of an EC point is None", key.text(X509.rsa_key(key)), "F"),
       T.eq("leaf: ecdsa_sig of a short element is None", key.text(X509.ecdsa_sig(Bytes.of_hex("05 00"))), "F")]
    case None{}:
      [T.eq("leaf: parsed", "F", "Some")]

