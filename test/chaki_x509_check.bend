def print.lines(xs: List<&2, String>) -> IO(Unit):
  match xs:
    case Nil{}:
      IO.pure(Unit, Unit{})
    case Con{h, t}:
      do IO<Unit>:
        IO.print(h)
        u : Unit <- print.lines(t)
        return u

def dns.text(xs: List<&2, String>) -> String:
  match xs:
    case Nil{}:
      ""
    case Con{h, Nil{}}:
      h
    case Con{h, t}:
      h ++ "," ++ dns.text(t)

def ok.of(m: Maybe<&2, X509.Cert>) -> String:
  match m:
    case Some{c}:
      "Some"
    case None{}:
      "F"

def key.text(m: Maybe<&2, X509.Two()>) -> String:
  match m:
    case Some{(a, b)}:
      Bytes.to_hex(a) ++ ":" ++ Bytes.to_hex(b)
    case None{}:
      "F"

def root.checks(m: Maybe<&2, X509.Cert>) -> List<&2, String>:
  match m:
    case Some{X509.Cert{+der, +tbs, +sig_alg, +sig, +issuer, +subject, +not_before, +not_after, +key_alg, +key_curve, +key, +dns, +ca, +path_len, +key_usage, +unknown_critical, +server_auth}}:
      [T.hex("root: der", der, ""),
       T.hex("root: tbs", tbs, ""),
       T.eq("root: sig_alg", sig_alg, "1.2.840.113549.1.1.11"),
       T.hex("root: issuer", issuer, "304d310b300906035504061302434c3113301106035504080c0a4d6167616c6c616e65733111300f060355040a0c0863686120746573743116301406035504030c0d636861207465737420726f6f74"),
       T.hex("root: subject", subject, "304d310b300906035504061302434c3113301106035504080c0a4d6167616c6c616e65733111300f060355040a0c0863686120746573743116301406035504030c0d636861207465737420726f6f74"),
       T.hex("root: sig", sig, ""),
       T.eq("root: not_before", U32.show(not_before), "1791084346"),
       T.eq("root: not_after", U32.show(not_after), "2106444346"),
       T.eq("root: key_alg", key_alg, "1.2.840.113549.1.1.1"),
       T.eq("root: key_curve", key_curve, ""),
       T.hex("root: key", key, ""),
       T.eq("root: dns", dns.text(dns), ""),
       T.eq("root: ca", T.yes(ca), "yes"),
       T.eq("root: path_len", U32.show(path_len), "4294967295"),
       T.eq("root: key_usage", U32.show(key_usage), "96"),
       T.eq("root: unknown_critical", T.yes(unknown_critical), "no"),
       T.eq("root: server_auth", T.yes(server_auth), "yes"),
       T.eq("root: rsa_key", key.text(X509.rsa_key(key)), ":010001"),
       T.eq("root: an RSA signature is no ECDSA-Sig-Value", key.text(X509.ecdsa_sig(sig)), "F")]
    case None{}:
      [T.eq("root: parsed", "F", "Some")]

