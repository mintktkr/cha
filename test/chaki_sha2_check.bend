# offline checks for lib/chaki/sha2.bend. The vectors are from the primary texts:
# RFC 6234 8.5 (the FIPS 180-3 tests), RFC 4231 4.2-4.8 (HMAC), RFC 5869 A.1-A.3
# (HKDF) and RFC 8448 3 (the TLS 1.3 key schedule). The digests of the empty,
# 55, 56, 63, 64 and 65 byte messages and the empty-key MAC come from `openssl dgst`.
import Base
import ../lib/chaki/bytes.bend as Bytes
import ../lib/chaki/check.bend as T
import ../lib/chaki/sha2.bend as Sha2

def s256(msg: List<&2, U32>) -> List<&2, U32>:
  Sha2.hash(Sha2.S256{}, msg)

def s384(msg: List<&2, U32>) -> List<&2, U32>:
  Sha2.hash(Sha2.S384{}, msg)

def s512(msg: List<&2, U32>) -> List<&2, U32>:
  Sha2.hash(Sha2.S512{}, msg)

def mac256(key: List<&2, U32>, msg: List<&2, U32>) -> List<&2, U32>:
  Sha2.hmac(Sha2.S256{}, key, msg)

def mac384(key: List<&2, U32>, msg: List<&2, U32>) -> List<&2, U32>:
  Sha2.hmac(Sha2.S384{}, key, msg)

def mac512(key: List<&2, U32>, msg: List<&2, U32>) -> List<&2, U32>:
  Sha2.hmac(Sha2.S512{}, key, msg)

# RFC 8448 3: the 1-RTT handshake's ClientHello and ServerHello, in order, and
# the x25519 shared secret both peers end up with
def tls.client_hello() -> List<&2, U32>:
  Bytes.of_hex("")

def tls.server_hello() -> List<&2, U32>:
  Bytes.of_hex("020000560303a6af06a4121860dc5e6e60249cd34c95930c8ac5cb1434dac155772ed3e2692800130100002e00330024001d0020c9828876112095fe66762bdbf7c672e156d6cc253b833df1dd69b1b04e751f0f002b00020304")

def tls.transcript() -> List<&2, U32>:
  Bytes.cat(tls.client_hello(), tls.server_hello())

def tls.shared() -> List<&2, U32>:
  Bytes.of_hex("8bd4054fb55b9d63fdfbacf9f04b9f0d35e6d63f537563efd46272900f89492d")

def main() -> IO(Unit):
  do IO<Unit>:
    # The digest sizes
    IO.print(T.eq("size 256", U32.show(Sha2.size(Sha2.S256{})), "32"))
    IO.print(T.eq("size 384", U32.show(Sha2.size(Sha2.S384{})), "48"))
    IO.print(T.eq("size 512", U32.show(Sha2.size(Sha2.S512{})), "64"))

    # RFC 6234 8.5

    IO.print(T.hex("RFC 6234 8.5 TEST1 empty sha256", s256(Nil{}), "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"))
    IO.print(T.hex("RFC 6234 8.5 TEST1 empty sha384", s384(Nil{}), "38b060a751ac96384cd9327eb1b1e36a21fdb71114be07434c0cc7bf63f6e1da274edebfe76f65fbd51ad2f14898b95b"))
    IO.print(T.hex("RFC 6234 8.5 TEST1 empty sha512", s512(Nil{}), "cf83e1357eefb8bdf1542850d66d8007d620e4050b5715dc83f4a921d36ce9ce47d0d13c5d85f2b0ff8318d2877eec2f63b931bd47417a81a538327af927da3e"))
    IO.print(T.hex("RFC 6234 8.5 TEST1 sha256", s256(Bytes.of_ascii("abc")),
      "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad"))
    IO.print(T.hex("RFC 6234 8.5 TEST2 sha256", s256(Bytes.of_hex("6162636462636465636465666465666765666768666768696768696a68696a6b696a6b6c6a6b6c6d6b6c6d6e6c6d6e6f6d6e6f706e6f7071")),
      "248d6a61d20638b8e5c026930c3e6039a33ce45964ff2167f6ecedd419db06c1"))
    IO.print(T.hex("RFC 6234 8.5 TEST4 sha256", s256(Bytes.of_hex("")),
      "594847328451bdfa85056225462cc1d867d877fb388df0ce35f25ab5562bfbb5"))
    IO.print(T.hex("RFC 6234 8.5 test 6 one byte sha256", s256(Bytes.of_hex("19")),
      "68aa2e2ee5dff96e3355e6c7ee373e3d6a4e17f75f9518d843709c0c9bc3e3d4"))
    IO.print(T.hex("openssl sha256 a*55", s256(Sha2.fill(97, 55n)),
      "9f4390f8d30c2dd92ec9f095b65e2b9ae9b0a925a5258e241c9f1e910f734318"))
    IO.print(T.hex("openssl sha256 a*56", s256(Sha2.fill(97, 56n)),
      "b35439a4ac6f0948b6d6f9e3c6af0f5f590ce20f1bde7090ef7970686ec6738a"))
    IO.print(T.hex("openssl sha256 a*63", s256(Sha2.fill(97, 63n)),
      "7d3e74a05d7db15bce4ad9ec0658ea98e3f06eeecf16b4c6fff2da457ddc2f34"))
    IO.print(T.hex("openssl sha256 a*64", s256(Sha2.fill(97, 64n)),
      "ffe054fe7ae0cb6dc65c3af9b61d5209f439851db43d0ba5997337df154668eb"))
    IO.print(T.hex("openssl sha256 a*65", s256(Sha2.fill(97, 65n)),
      "635361c48bb9eab14198e76ea8ab7f1a41685d6ad62aa9146d301d4f17eb0ae0"))
    IO.print(T.hex("RFC 6234 8.5 TEST3 sha256 a*1000000", s256(Sha2.fill(97, 1000000n)),
      "cdc76e5c9914fb9281a1c7e284d73e67f1809a48a497200e046d39ccc7112cd0"))
    IO.print(T.hex("RFC 6234 8.5 TEST1 sha384", s384(Bytes.of_ascii("abc")),
      "cb00753f45a35e8bb5a03d699ac65007272c32ab0eded1631a8b605a43ff5bed8086072ba1e7cc2358baeca134c825a7"))
    IO.print(T.hex("RFC 6234 8.5 TEST2 sha384", s384(Bytes.of_hex("61626364656667686263646566676869636465666768696a6465666768696a6b65666768696a6b6c666768696a6b6c6d6768696a6b6c6d6e68696a6b6c6d6e6f696a6b6c6d6e6f706a6b6c6d6e6f70716b6c6d6e6f7071726c6d6e6f707172736d6e6f70717273746e6f707172737475")),
      "09330c33f71147e83d192fc782cd1b4753111b173b3b05d22fa08086e3b0f712fcc7c71a557e2db966c3e9fa91746039"))
    IO.print(T.hex("RFC 6234 8.5 TEST4 sha384", s384(Bytes.of_hex("")),
      "2fc64a4f500ddb6828f6a3430b8dd72a368eb7f3a8322a70bc84275b9c0b3ab00d27a5cc3c2d224aa6b61a0d79fb4596"))
    IO.print(T.hex("RFC 6234 8.5 test 6 one byte sha384", s384(Bytes.of_hex("b9")),
      "bc8089a19007c0b14195f4ecc74094fec64f01f90929282c2fb392881578208ad466828b1c6c283d2722cf0ad1ab6938"))
    IO.print(T.hex("openssl sha384 a*55", s384(Sha2.fill(97, 55n)),
      "5d91ac7e74e62b5c728904b40f10784d66b7af9cb6302123e48c92f0432ceb8d2a92c02de77dcb29ed75c4b42bde46f4"))
    IO.print(T.hex("openssl sha384 a*56", s384(Sha2.fill(97, 56n)),
      "8a8d9649ea04e993a6ca7135af7e3392cc5fca84f8531cac7aa3feed4eb98f55dcbe0f3284b61c6f35f98b02cc644b4c"))
    IO.print(T.hex("openssl sha384 a*63", s384(Sha2.fill(97, 63n)),
      "7e7f097e95b52bb8f53383450ecaf9868187c130981730c03b6d573adfc0b991e365244e5b4bfa082bfb43c517d37120"))
    IO.print(T.hex("openssl sha384 a*64", s384(Sha2.fill(97, 64n)),
      "2e404b9339da795776e510d96930b3be2904c500395b8cb7413334b82d4dec413b4b8113045a05bbbcff846f027423f6"))
    IO.print(T.hex("openssl sha384 a*65", s384(Sha2.fill(97, 65n)),
      "a2b797de45aa1d20594e2ea0cb1801d6dd7ffa3a58281c37dde04029f1c98157bb6eb005e90dd76b79a1d6ddd52dd58d"))
    IO.print(T.hex("RFC 6234 8.5 TEST3 sha384 a*1000000", s384(Sha2.fill(97, 1000000n)),
      "9d0e1809716474cb086e834e310a4a1ced149e9c00f248527972cec5704c2a5b07b8b3dc38ecc4ebae97ddd87f3d8985"))
    IO.print(T.hex("RFC 6234 8.5 TEST1 sha512", s512(Bytes.of_ascii("abc")),
      "ddaf35a193617abacc417349ae20413112e6fa4e89a97ea20a9eeee64b55d39a2192992a274fc1a836ba3c23a3feebbd454d4423643ce80e2a9ac94fa54ca49f"))
    IO.print(T.hex("RFC 6234 8.5 TEST2 sha512", s512(Bytes.of_hex("61626364656667686263646566676869636465666768696a6465666768696a6b65666768696a6b6c666768696a6b6c6d6768696a6b6c6d6e68696a6b6c6d6e6f696a6b6c6d6e6f706a6b6c6d6e6f70716b6c6d6e6f7071726c6d6e6f707172736d6e6f70717273746e6f707172737475")),
      "8e959b75dae313da8cf4f72814fc143f8f7779c6eb9f7fa17299aeadb6889018501d289e4900f7e4331b99dec4b5433ac7d329eeb6dd26545e96e55b874be909"))
    IO.print(T.hex("RFC 6234 8.5 TEST4 sha512", s512(Bytes.of_hex("")),
      "89d05ba632c699c31231ded4ffc127d5a894dad412c0e024db872d1abd2ba8141a0f85072a9be1e2aa04cf33c765cb510813a39cd5a84c4acaa64d3f3fb7bae9"))
    IO.print(T.hex("RFC 6234 8.5 test 6 one byte sha512", s512(Bytes.of_hex("d0")),
      "9992202938e882e73e20f6b69e68a0a7149090423d93c81bab3f21678d4aceeee50e4e8cafada4c85a54ea8306826c4ad6e74cece9631bfa8a549b4ab3fbba15"))
    IO.print(T.hex("openssl sha512 a*55", s512(Sha2.fill(97, 55n)),
      "b0220c772cbf6c1822e2cb38a437d0e1d58772417a4bbb21c961364f8b6143e05aa6316dca8d1d7b19e16448419076395f6086cb55101fbd6d5497b148e1745f"))
    IO.print(T.hex("openssl sha512 a*56", s512(Sha2.fill(97, 56n)),
      "962b64aae357d2a4fee3ded8b539bdc9d325081822b0bfc55583133aab44f18bafe11d72a7ae16c79ce2ba620ae2242d5144809161945f1367f41b3972e26e04"))
    IO.print(T.hex("openssl sha512 a*63", s512(Sha2.fill(97, 63n)),
      "c1b0f5c6d3b03dfe4a2602e67242f54e344090b66e01100a469b129f583f016c7e27dddeaa438393dcc7ec54b0b57c9ba7af007f9b56db5f6fb677d972a31362"))
    IO.print(T.hex("openssl sha512 a*64", s512(Sha2.fill(97, 64n)),
      "01d35c10c6c38c2dcf48f7eebb3235fb5ad74a65ec4cd016e2354c637a8fb49b695ef3c1d6f7ae4cd74d78cc9c9bcac9d4f23a73019998a7f73038a5c9b2dbde"))
    IO.print(T.hex("openssl sha512 a*65", s512(Sha2.fill(97, 65n)),
      "b83086cd8494e55708ad7ecd82dfb4bca1bda61ecbb7caf0c68967902e709345e5d8305eb7ac0d588afc6cbb75161aa9c8c7e0ea986bd833dafe5e1ccd37345a"))
    IO.print(T.hex("RFC 6234 8.5 TEST3 sha512 a*1000000", s512(Sha2.fill(97, 1000000n)),
      "e718483d0ce769644e2e42c7bc15b4638e1f98b13b2044285632a803afa973ebde0ff244877ea60a4cb0432ce577c31beb009c5c2c49aa2e4eadb217ad8cc09b"))

    # RFC 4231 4.2-4.8

    IO.print(T.hex("RFC 4231 case 1 sha256", mac256(Bytes.of_hex("0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b"), Bytes.of_hex("4869205468657265")),
      "b0344c61d8db38535ca8afceaf0bf12b881dc200c9833da726e9376c2e32cff7"))
    IO.print(T.hex("RFC 4231 case 1 sha384", mac384(Bytes.of_hex("0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b"), Bytes.of_hex("4869205468657265")),
      "afd03944d84895626b0825f4ab46907f15f9dadbe4101ec682aa034c7cebc59cfaea9ea9076ede7f4af152e8b2fa9cb6"))
    IO.print(T.hex("RFC 4231 case 1 sha512", mac512(Bytes.of_hex("0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b"), Bytes.of_hex("4869205468657265")),
      "87aa7cdea5ef619d4ff0b4241a1d6cb02379f4e2ce4ec2787ad0b30545e17cdedaa833b7d6b8a702038b274eaea3f4e4be9d914eeb61f1702e696c203a126854"))
    IO.print(T.hex("RFC 4231 case 2 sha256", mac256(Bytes.of_hex("4a656665"), Bytes.of_hex("7768617420646f2079612077616e7420666f72206e6f7468696e673f")),
      "5bdcc146bf60754e6a042426089575c75a003f089d2739839dec58b964ec3843"))
    IO.print(T.hex("RFC 4231 case 2 sha384", mac384(Bytes.of_hex("4a656665"), Bytes.of_hex("7768617420646f2079612077616e7420666f72206e6f7468696e673f")),
      "af45d2e376484031617f78d2b58a6b1b9c7ef464f5a01b47e42ec3736322445e8e2240ca5e69e2c78b3239ecfab21649"))
    IO.print(T.hex("RFC 4231 case 2 sha512", mac512(Bytes.of_hex("4a656665"), Bytes.of_hex("7768617420646f2079612077616e7420666f72206e6f7468696e673f")),
      "164b7a7bfcf819e2e395fbe73b56e0a387bd64222e831fd610270cd7ea2505549758bf75c05a994a6d034f65f8f0e6fdcaeab1a34d4a6b4b636e070a38bce737"))
    IO.print(T.hex("RFC 4231 case 3 sha256", mac256(Bytes.of_hex("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"), Bytes.of_hex("dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd")),
      "773ea91e36800e46854db8ebd09181a72959098b3ef8c122d9635514ced565fe"))
    IO.print(T.hex("RFC 4231 case 3 sha384", mac384(Bytes.of_hex("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"), Bytes.of_hex("dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd")),
      "88062608d3e6ad8a0aa2ace014c8a86f0aa635d947ac9febe83ef4e55966144b2a5ab39dc13814b94e3ab6e101a34f27"))
    IO.print(T.hex("RFC 4231 case 3 sha512", mac512(Bytes.of_hex("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"), Bytes.of_hex("dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd")),
      "fa73b0089d56a284efb0f0756c890be9b1b5dbdd8ee81a3655f83e33b2279d39bf3e848279a722c806b485a47e67c807b946a337bee8942674278859e13292fb"))
    IO.print(T.hex("RFC 4231 case 4 sha256", mac256(Bytes.of_hex("0102030405060708090a0b0c0d0e0f10111213141516171819"), Bytes.of_hex("cdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcd")),
      "82558a389a443c0ea4cc819899f2083a85f0faa3e578f8077a2e3ff46729665b"))
    IO.print(T.hex("RFC 4231 case 4 sha384", mac384(Bytes.of_hex("0102030405060708090a0b0c0d0e0f10111213141516171819"), Bytes.of_hex("cdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcd")),
      "3e8a69b7783c25851933ab6290af6ca77a9981480850009cc5577c6e1f573b4e6801dd23c4a7d679ccf8a386c674cffb"))
    IO.print(T.hex("RFC 4231 case 4 sha512", mac512(Bytes.of_hex("0102030405060708090a0b0c0d0e0f10111213141516171819"), Bytes.of_hex("cdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcd")),
