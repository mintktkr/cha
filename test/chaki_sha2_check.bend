      "b613679a0814d9ec772f95d778c35fc5ff1697c493715653c6c712144292c5ad"))

    # RFC 5869 A.1-A.3

    IO.print(T.hex("RFC 5869 A.1 extract", Sha2.extract(Sha2.S256{}, Bytes.of_hex("000102030405060708090a0b0c"), Bytes.of_hex("0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b")),
      "077709362c2e32df0ddc3f0dc47bba6390b6c73bb50f9c3122ec844ad7c2b3e5"))
