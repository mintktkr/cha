# offline checks for lib/chaki/x509v.bend. The fixtures are a synthetic PKI made with
# openssl on 2026-10-04 (only the certificates are here; their keys were never kept):
#   root      RSA-2048, self-signed, CA, keyCertSign
#   int       EC P-256, CA pathlen:0, signed by root
#   leaf      EC P-384 for cha.test and *.Cha.TEST, signed by int (ecdsa-with-SHA384)
#   leafRSA   RSA-2048 for direct.cha.test, signed by root
#   int2      EC P-256 CA under int, so it breaks int's pathlen:0; leafDeep sits under it
#   intNoKS   a CA without keyCertSign; leafNoKS sits under it
#   evil      signed by the leaf, which isn't a CA
#   nc        a leaf with a critical nameConstraints extension
#   pss       a leaf signed with RSASSA-PSS, which the engine doesn't check
#   ekuClient a self-signed leaf for eku.cha.test whose extKeyUsage is clientAuth only; its
#             SAN names the host, so only the missing serverAuth can refuse it
# The commands: openssl req -x509 / openssl x509 -req with -extfile, per the .ext files
# kept beside them (basicConstraints, keyUsage, subjectAltName, nameConstraints,
# extendedKeyUsage).
import Base
import ../lib/chaki/bytes.bend as Bytes
import ../lib/chaki/b64.bend as B64
import ../lib/chaki/x509.bend as X509
import ../lib/chaki/x509v.bend as V
import ../lib/chaki/check.bend as T

def fx.root() -> List<&2, U32>:
  Bytes.of_hex("")

def fx.int() -> List<&2, U32>:
  Bytes.of_hex("")

def fx.int2() -> List<&2, U32>:
  Bytes.of_hex("")

def fx.intNoKS() -> List<&2, U32>:
  Bytes.of_hex("")

def fx.leaf() -> List<&2, U32>:
  Bytes.of_hex("")

def fx.leafRSA() -> List<&2, U32>:
  Bytes.of_hex("")

def fx.leafDeep() -> List<&2, U32>:
  Bytes.of_hex("")

def fx.leafNoKS() -> List<&2, U32>:
  Bytes.of_hex("")

def fx.evil() -> List<&2, U32>:
  Bytes.of_hex("")

def fx.nc() -> List<&2, U32>:
  Bytes.of_hex("")

def fx.pss() -> List<&2, U32>:
  Bytes.of_hex("")

def fx.ekuClient() -> List<&2, U32>:
  Bytes.of_hex("")

# the day after the fixtures were made, a year on (leaves expired), and the day before
def NOW() -> U32:
  1791158400

def LATER() -> U32:
  1822694400

def EARLIER() -> U32:
  1790985600

def cert(der: List<&2, U32>) -> X509.Cert:
  Maybe.default(&2, X509.Cert, X509.parse(der), X509.Cert{Nil{}, Nil{}, "", Nil{}, Nil{}, Nil{}, 0, 0, "", "", Nil{}, Nil{}, False{}, 0, 0, False{}, True{}})

def roots() -> List<&2, X509.Cert>:
  [cert(fx.root())]

def said(r: Result<&1, &1, String, Unit>) -> String:
  match r:
    case Done{u}:
      "trusted"
    case Fail{w}:
      w

def check(+name: String, chain: List<&2, List<&2, U32>>, +host: String, +now: U32, +want: String) -> String:
  T.eq(name, said(V.verify(chain, roots(), host, now)), want)

# the leaf with one bit of its signature flipped (the last byte of the DER)
def tampered() -> List<&2, U32>:
  +d = fx.leaf()
  Bytes.cat(Bytes.take(d, Nat.sub(U32.to_nat(Bytes.len(d)), 1n)), [U32.xor(Bytes.get.be(Bytes.drop(d, Nat.sub(U32.to_nat(Bytes.len(d)), 1n)), 1n), 1)])

def pem.of(der: List<&2, U32>) -> String:
  "-----BEGIN CERTIFICATE-----\n" ++ B64.encode(der) ++ "\n-----END CERTIFICATE-----\n"

def bundle() -> String:
  "# a comment\n" ++ pem.of(fx.root()) ++ "junk\n" ++ pem.of(fx.int()) ++ "-----BEGIN CERTIFICATE-----\nbm90IGEgY2VydA==\n-----END CERTIFICATE-----\n"

def main() -> IO(Unit):
  do IO<Unit>:
    IO.print(check("leaf <- int <- root", [fx.leaf(), fx.int()], "cha.test", NOW(), "trusted"))
    IO.print(check("a wildcard name", [fx.leaf(), fx.int()], "x.cha.test", NOW(), "trusted"))
    IO.print(check("names are case-insensitive", [fx.leaf(), fx.int()], "X.CHA.Test", NOW(), "trusted"))
    IO.print(check("a trailing dot is the same host", [fx.leaf(), fx.int()], "cha.test.", NOW(), "trusted"))
    IO.print(check("RSA leaf straight under the root", [fx.leafRSA()], "direct.cha.test", NOW(), "trusted"))
    IO.print(check("junk among the sent certificates is ignored", [fx.leaf(), fx.leafRSA(), fx.int(), fx.nc()], "cha.test", NOW(), "trusted"))
    IO.print(check("the root sent along is fine", [fx.leaf(), fx.int(), fx.root()], "cha.test", NOW(), "trusted"))
    IO.print(check("expired", [fx.leaf(), fx.int()], "cha.test", LATER(), "the server's certificate has expired"))
    IO.print(check("not yet valid", [fx.leaf(), fx.int()], "cha.test", EARLIER(), "the server's certificate isn't valid yet"))
    IO.print(check("the wrong host", [fx.leaf(), fx.int()], "other.test", NOW(), "the server's certificate isn't for other.test"))
    IO.print(check("a wildcard covers one label only", [fx.leaf(), fx.int()], "a.b.cha.test", NOW(), "the server's certificate isn't for a.b.cha.test"))
    IO.print(check("an IP literal never matches a name", [fx.leaf(), fx.int()], "127.0.0.1", NOW(), "the server's certificate isn't for 127.0.0.1"))
    IO.print(check("an issuer that isn't a CA", [fx.evil(), fx.leaf(), fx.int()], "evil.cha.test", NOW(), "an issuer in the chain isn't a CA"))
    IO.print(check("an issuer without keyCertSign", [fx.leafNoKS(), fx.intNoKS()], "noks.cha.test", NOW(), "an issuer in the chain may not sign certificates"))
    IO.print(check("a pathlen violation", [fx.leafDeep(), fx.int2(), fx.int()], "deep.cha.test", NOW(), "the chain is longer than an issuer allows"))
    IO.print(check("a tampered signature", [tampered(), fx.int()], "cha.test", NOW(), "the chain doesn't lead to a trusted root"))
    IO.print(check("a missing intermediate", [fx.leaf()], "cha.test", NOW(), "the chain doesn't lead to a trusted root"))
    IO.print(check("an unknown critical extension", [fx.nc()], "nc.cha.test", NOW(), "the server's certificate has a critical extension chaki doesn't know"))
    IO.print(check("a leaf issued only for clientAuth", [fx.ekuClient()], "eku.cha.test", NOW(), "the server's certificate isn't for TLS servers"))
    IO.print(check("an RSASSA-PSS signature isn't checked, so it isn't trusted", [fx.pss()], "pss.cha.test", NOW(), "the chain doesn't lead to a trusted root"))
    IO.print(check("an empty chain", Nil{}, "cha.test", NOW(), "the server sent no certificate"))
    IO.print(check("garbage for a leaf", [[1, 2, 3]], "cha.test", NOW(), "the server's certificate doesn't parse"))
    IO.print(T.ok("signed_by: int under root", V.signed_by(cert(fx.int()), cert(fx.root()))))
    IO.print(T.ok("signed_by: leaf not under root", Bool.not(V.signed_by(cert(fx.leaf()), cert(fx.root())))))
    IO.print(T.eq("anchors from a PEM bundle, junk around", U32.show(U32.from_nat(List.length(&2, X509.Cert, V.anchors(bundle())))), "2"))
